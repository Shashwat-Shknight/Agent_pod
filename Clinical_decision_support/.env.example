# Copy to .env (never commit .env). `python -m app.db.setup init --account ...` creates it for you.

# =====================================================================
#  LLM - fill ONE of the two options
# =====================================================================
# Option A: Coforge AI Studio / LLM Router (office)
COFORGE_API_URL=
COFORGE_API_KEY=
COFORGE_MODEL=
# Optional separate key/endpoint for CPT generation (defaults to the values above)
# COFORGE_CPT_API_URL=
# COFORGE_CPT_API_KEY=

# Option B: Grok (xai-...) or Groq (gsk_...) key - paste between the quotes. Takes precedence when set.
GROK_API_KEY=""
# GROK_MODEL=        # optional; auto-selected when empty

# =====================================================================
#  Storage
# =====================================================================
# snowflake (production) | json (offline dev / unit tests)
STORAGE_BACKEND=snowflake

# Runtime service user (key-pair auth, created by the bootstrap SQL)
SNOWFLAKE_ACCOUNT=<ORGNAME-ACCOUNTNAME>
SNOWFLAKE_USER=NUUCARE_APP_SVC
SNOWFLAKE_PRIVATE_KEY_PATH=~/.snowflake/keys/nuucare_app_svc.p8
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
SNOWFLAKE_ROLE=NUUCARE_APP
SNOWFLAKE_WAREHOUSE=NUUCARE_WH
SNOWFLAKE_DATABASE=NUUCARE_DB
SNOWFLAKE_POOL_SIZE=4

# Migration user (python -m app.db.migrate)
SNOWFLAKE_DEPLOY_USER=NUUCARE_DEPLOY_SVC
SNOWFLAKE_DEPLOY_PRIVATE_KEY_PATH=~/.snowflake/keys/nuucare_deploy_svc.p8
SNOWFLAKE_DEPLOY_ROLE=NUUCARE_OWNER

# =====================================================================
#  Official code sets (ICD-10-CM from CDC, HCPCS from CMS via NLM)
# =====================================================================
REFERENCE_AUTO_SYNC=1                 # daily check for new releases in the API process
REFERENCE_SYNC_INTERVAL_HOURS=24

# =====================================================================
#  Knowledge base retrieval
# =====================================================================
# tfidf = offline, no Hugging Face (default). sentence_transformer needs requirements-ml.txt.
EMBEDDING_BACKEND=tfidf

# --- Tuning (optional; defaults shown) -------------------------------------------------------
# SCRIBE_TEMPERATURE=0.2          # SOAP extraction: near-deterministic
# LLM_TEMPERATURE=0.3             # CDS and other generation
# CDS_MAX_PROBLEMS=5              # diagnoses researched per encounter
# CDS_PASSAGES_PER_PROBLEM=2      # Harrison's passages per diagnosis
# CDS_SUMMARY_TOP_K=5             # passages when no diagnosis list is available
# RULES_DIR=                      # folder with site-specific rule packs (overrides app/rules/packs)
# PAYER_GATEWAY=simulated         # payer connector: simulated until a clearinghouse connector is added
